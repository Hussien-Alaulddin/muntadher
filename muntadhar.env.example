# انسخ هذا الملف على السيرفر إلى:
# /home/u908955624/domains/muntadhar.studio/muntadhar.env
# أو: /home/u908955624/muntadhar.env
#
# لوحة متغيرات البيئة في Hostinger قد ترجع للقيم القديمة بعد Deploy.
# هذا الملف هو المصدر الثابت الذي يقرأه التطبيق عند البناء والتشغيل.

MYSQL_DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/DATABASE_NAME
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/DATABASE_NAME

MEDIA_ROOT=/home/u908955624/domains/muntadhar.studio/media
STORAGE_DRIVER=local
# مهم: استخدم مساراً مطلقاً. المسار النسبي "media" قد يكتب داخل مجلد النشر (.builds) لا مجلد المنزل.

NEXT_PUBLIC_SITE_URL=https://muntadhar.studio

# مسار سري للوحة التحكم — يجب أن يطابق مجلد src/app/m-6769c0
NEXT_PUBLIC_ADMIN_BASE_PATH=/m-6769c0

# كلمة مرور قوية للوحة (أقسام من 6 أحرف مفصولة بـ -)
ADMIN_API_TOKEN=

# إلزامي في الإنتاج — قيمة عشوائية طويلة منفصلة عن ADMIN_API_TOKEN
# openssl rand -base64 48
CUSTOMER_AUTH_SECRET=

# الإطلاق العام: المحتوى التجريبي معطّل افتراضياً في الكود
# لا تضبط DEMO_CONTENT=on إلا أثناء التجهيز الداخلي
DEMO_CONTENT=off
SEED_DEMO=off

# لا تضع SOURCE_DATABASE_URL ولا ALLOW_DB_MIGRATE في الإنتاج بعد اكتمال الترحيل

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-latest

# تسجيل الدخول عبر Google — من Google Cloud Console → OAuth 2.0 Client
# Authorized JavaScript origins: https://muntadhar.studio
# Authorized redirect URIs: https://muntadhar.studio/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
