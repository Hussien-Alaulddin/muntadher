# Supabase / PostgreSQL
# من: Project Settings → Database → Connection string
#
# للاستقرار على الخطة المجانية (Nano):
# 1) DATABASE_URL و DIRECT_URL = Session mode منفذ 5432
# 2) أضف دائماً: sslmode=require&connect_timeout=30&connection_limit=1
# 3) تجنّب فتح عدة خوادم dev معاً (تستنزف اتصالات Session ≈15)
# 4) لو المشروع Paused في Supabase → Restore أولاً
#
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=30&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=30"

# رفع الصور/الفيديو — من Project Settings → API
# NEXT_PUBLIC_SUPABASE_URL = رابط المشروع (https://PROJECT_REF.supabase.co)
# وليس رابط S3 الخاص بالـ Storage
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# اسم الـ bucket العام للصور التسويقية
BUCKET_NAME="muntader"
# bucket خاص (يُنشأ تلقائياً إن لم يوجد) للإيصالات وفيديوهات الدروس وملفات الكتيبات
# BUCKET_NAME_PRIVATE="muntader-private"
# اختياري — مرجع فقط؛ التطبيق يستخدم Supabase JS وليس S3 مباشرة
# BUCKET_URL="https://PROJECT_REF.storage.supabase.co/storage/v1/s3"

# توكن مؤقت لحماية واجهات لوحة التحكم (/api/admin/*)
ADMIN_API_TOKEN=""

# سر توقيع جلسات عملاء المتجر (تسجيل الدخول/التسجيل و Google OAuth)
# إلزامي في الإنتاج — استخدم قيمة عشوائية طويلة منفصلة عن ADMIN_API_TOKEN
# مثال توليد: openssl rand -base64 48
CUSTOMER_AUTH_SECRET=""

# اختياري: سر توقيع روابط الملفات المحلية (إن فُرغ يُستخدم CUSTOMER_AUTH_SECRET)
# MEDIA_SIGNING_SECRET=""

# معاينة الدورات بدون صلاحية في التطوير فقط (يتطلب NODE_ENV=development أيضاً)
# ALLOW_DEV_COURSE_PREVIEW=1

# تسجيل الدخول عبر Google (OAuth 2.0 Web Client)
# من: Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# رابط الموقع العام (للتطوير: http://localhost:3000)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# مساعد الدردشة بالذكاء الاصطناعي — Google Gemini (طبقة مجانية متاحة)
# احصل على المفتاح من: https://aistudio.google.com/apikey
# GEMINI_API_KEY="AIza..."
# GEMINI_CHAT_MODEL="gemini-flash-latest"

# المحتوى التجريبي مفعّل افتراضياً عشان يشوف المصمم كل الأقسام.
# قبل الإطلاق للعامة: DEMO_CONTENT=off لإخفائه، وSEED_DEMO=off لزراعة الهيكل فقط.
# DEMO_CONTENT=off
# SEED_DEMO=off
