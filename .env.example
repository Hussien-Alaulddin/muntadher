# Hostinger MySQL
# من: hPanel → Databases → MySQL
# على السيرفر: Host = localhost
# من جهازك: فعّل Remote MySQL ثم استخدم الهost الظاهر في اللوحة
#
# إذا كانت كلمة المرور فيها رموز (# * > / @ …) لازم تُرمَّز في الرابط:
# مثال: # → %23   * → %2A   > → %3E
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE_NAME"

# تخزين دائم على Hostinger (خارج مجلد نشر GitHub)
# مثال: /home/u908955624/media
MEDIA_ROOT="/home/u908955624/media"
# STORAGE_DRIVER=local

# توكن مؤقت لحماية واجهات لوحة التحكم (/api/admin/*)
ADMIN_API_TOKEN=""

# سر توقيع جلسات عملاء المتجر (تسجيل الدخول/التسجيل و Google OAuth)
# إلزامي في الإنتاج — استخدم قيمة عشوائية طويلة منفصلة عن ADMIN_API_TOKEN
# مثال توليد: openssl rand -base64 48
CUSTOMER_AUTH_SECRET=""

# اختياري: سر توقيع روابط الملفات المحلية (إن فُرغ يُستخدم CUSTOMER_AUTH_SECRET)
# MEDIA_SIGNING_SECRET=""

# معاينة الدورات بدون صلاحية في التطوير فقط (يتطلب NODE_ENV=development أيضاً)
# ALLOW_DEV_COURSE_PREVIEW=1

# تسجيل الدخول عبر Google (OAuth 2.0 Web Client)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# رابط الموقع العام (للتطوير: http://localhost:3000)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# مساعد الدردشة بالذكاء الاصطناعي — Google Gemini
# GEMINI_API_KEY="AIza..."
# GEMINI_CHAT_MODEL="gemini-flash-latest"

# المحتوى التجريبي مفعّل افتراضياً عشان يشوف المصمم كل الأقسام.
# قبل الإطلاق للعامة: DEMO_CONTENT=off لإخفائه، وSEED_DEMO=off لزراعة الهيكل فقط.
# DEMO_CONTENT=off
# SEED_DEMO=off

# --- ترحيل لمرة واحدة من Supabase (اختياري) ---
# SOURCE_DATABASE_URL="postgresql://...supabase..."
# NEXT_PUBLIC_SUPABASE_URL=...
# SUPABASE_SERVICE_ROLE_KEY=...
# BUCKET_NAME=muntader
